{
  "name": "habita",
  "version": "1.0.0",
  "description": "A visual Eisenhower Matrix task manager that blocks out time for your tasks in the phone's own calendar. Offline-first, drag-and-drop, dark mode. Packaged for Android with Capacitor.",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/akshayaa-403/Habita",
  "repository": {
    "type": "git",
    "url": "https://github.com/akshayaa-403/Habita.git"
  },
  "scripts": {
    "start": "npx serve src",
    "test": "node tests/timeline.test.mjs",
    "sync": "cap sync",
    "open:android": "cap open android",
    "android": "cap sync android && cap open android",
    "icons": "node assets/make-icon.js && node assets/build-android-icons.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/haptics": "^8.0.2"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "sharp": "^0.35.5"
  }
}
