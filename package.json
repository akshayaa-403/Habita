{
  "name": "habita",
  "version": "1.0.0",
  "description": "A visual Eisenhower Matrix task manager that blocks out time for your tasks in the phone's own calendar. Offline-first, drag-and-drop, dark mode. Packaged for Android with Capacitor.",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/akshayaa-403/Habita",
  "repository": {
    "type": "git",
    "url": "https://github.com/akshayaa-403/Habita.git"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "npm run build && npx serve www",
    "serve": "npx serve www",
    "pretest": "npm run build",
    "test": "node tests/timeline.test.mjs",
    "sync": "npm run build && cap sync",
    "open:android": "cap open android",
    "android": "npm run build && cap sync android && cap open android",
    "icon:master": "node assets/make-icon.js",
    "icons": "node assets/make-icon.js && node assets/build-android-icons.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "jsdom": "^30.0.1"
  }
}
